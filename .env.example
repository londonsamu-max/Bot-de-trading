# SpotGamma Credentials
SPOTGAMMA_EMAIL=your_email@example.com
SPOTGAMMA_PASSWORD=your_password_here

# MetaTrader 5 Credentials (Pepperstone)
MT5_LOGIN=12345678
MT5_PASSWORD=your_mt5_password
MT5_SERVER=Pepperstone-MT5-Live01

# Optional
LOG_LEVEL=INFO

# ---------------------------------------------------------------------------
# Flujo de ordenes de trabajo (python workflow.py)
# ---------------------------------------------------------------------------

# Buzon que recibe los correos de clientes y envia los avisos.
# Google Workspace: imap.gmail.com / smtp.gmail.com  (usa contrasena de aplicacion)
# Microsoft 365:    outlook.office365.com / smtp.office365.com
IMAP_HOST=imap.gmail.com
SMTP_HOST=smtp.gmail.com
WORKFLOW_EMAIL_USER=Workorder@jbrenovate.com
WORKFLOW_EMAIL_PASSWORD=tu_contrasena_de_aplicacion

# A quien se le avisa cuando algo necesita atencion humana (opcional)
SUPERVISOR_EMAIL=
SUPERVISOR_WHATSAPP=

# WhatsApp via Twilio (solo si whatsapp.proveedor = "twilio")
TWILIO_ACCOUNT_SID=
TWILIO_AUTH_TOKEN=
TWILIO_WHATSAPP_FROM=+14155238886

# WhatsApp via Meta Cloud API (solo si whatsapp.proveedor = "meta")
META_PHONE_NUMBER_ID=
META_ACCESS_TOKEN=
META_VERIFY_TOKEN=
